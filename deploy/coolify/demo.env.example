# Environment variables for the LOGIFLOW DEMO stack
# (docker-compose.coolify-demo.yml). Read that file's header first — the API in
# it runs in Development mode on purpose, and the reasoning matters.

# REQUIRED. The SQL Server sa password. SQL Server enforces its own complexity
# rules (8+ chars, three of: upper, lower, digit, symbol) and exits at boot
# without explanation if they are not met — so generate, do not invent:
#
#   openssl rand -base64 24
#
# Note that this value is interpolated into a connection string in the compose
# file. Avoid a literal ';' in it, which would terminate the string early.
MSSQL_SA_PASSWORD=replace-me-generate-a-strong-one

# REQUIRED. Overrides the development signing key that is committed in
# src/LogiFlow.Api/appsettings.Development.json — a key that is public in a
# public repository and therefore forges an Admin token for anybody who reads
# it. At least 32 bytes:
#
#   openssl rand -base64 48
LOGIFLOW_JWT_SIGNING_KEY=replace-me-with-openssl-rand-base64-48
