# Environment variables for the ACADEMY stack (docker-compose.coolify.yml).
#
# Paste into Coolify → your resource → Environment Variables → "Developer view",
# which accepts a whole .env at once. Do NOT commit the filled-in version:
# .gitignore already blocks .env and .env.* for exactly this reason.

# REQUIRED. The JWT signing key. At least 32 bytes; the service refuses to
# start without it, which is the behaviour you want from a missing secret.
#
#   openssl rand -base64 48
#
# Mark it as a "secret"/build-time-hidden variable in Coolify. Changing it later
# signs everyone out but destroys no data.
ACADEMY_JWT_SIGNING_KEY=replace-me-with-openssl-rand-base64-48

# Sign-in / register / password-reset attempts per minute, per client IP.
# The in-code default is 10. 20 is kinder to a household or an office that
# shares one public address, and still stops a credential-stuffing run.
ACADEMY_AUTH_REQUESTS_PER_MINUTE=20
