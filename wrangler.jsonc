{
  // C# / .NET academy — static site on Cloudflare Workers static assets.
  //
  // Assets-only: there is no "main", so no Worker script runs and every request
  // is served straight from ./site. Deploy with `npx wrangler deploy` from this
  // directory.
  //
  // NOTE: this deploys the STUDY SITE only. The account API (LogiFlow.Academy.Api,
  // SQLite in App_Data) is not part of this and is not reachable from here, so
  // sign-in / sync / leaderboard will fail until an API host exists. Everything
  // else works — store.js keeps the whole profile in localStorage.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "csharp-academy",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,

  // The public name.
  //
  // A SUBDOMAIN, deliberately. The apex and www already have DNS records that
  // are in use for something else, and a Workers custom domain has to OWN its
  // record: Cloudflare creates it and issues the certificate. Pointing this at
  // testdemo.it would have meant deleting those records first, which is why the
  // first attempt failed with code 100117 and why it stays a subdomain.
  //
  // Nothing else in the zone is touched. csharp.testdemo.it had no record of
  // its own and there is no wildcard, so this adds one name and changes none.
  //
  // workers_dev stays on above, so csharp-academy.krsiti-komini.workers.dev
  // keeps working as a fallback and as somewhere to check a deploy without
  // touching the public name.
  "routes": [
    { "pattern": "csharp.testdemo.it", "custom_domain": true }
  ],
  "assets": {
    "directory": "./site",
    // Serves / as index.html, which is the reason not to use "none": that
    // setting removes the redirect below but 404s the bare domain, and the bare
    // domain is what people type.
    //
    // The trade is that it 307s /chapters/x.html to /chapters/x, and .html is
    // what the whole site links to. That redirect is harmless to a browser on
    // its own, and was NOT harmless to the service worker: cache.add() followed
    // it and stored responses with redirected: true, which a browser refuses to
    // use for a navigation. Fixed in sw.js, which now rebuilds each response
    // rather than trusting the host not to redirect. See the note there.
    "html_handling": "auto-trailing-slash",
    // "none" rather than "404-page": there is no site/404.html yet. Add one and
    // switch this to "404-page" if you want a branded miss.
    "not_found_handling": "none"
  }
}
