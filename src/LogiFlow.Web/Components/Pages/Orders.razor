@page "/"
@page "/orders"
@using System.Globalization
@implements IDisposable
@inject LogiFlowApiClient Api
@inject NavigationManager Nav

<PageTitle>Orders — LogiFlow</PageTitle>

<h1>Orders</h1>

<p class="subtitle">
    Filtering, sorting and paging all happen in SQL. This page never holds more than one page of
    rows — see <code>module-16</code> on why that distinction is the whole game.
</p>

<Explain Emoji="🗄️" Title="What is this screen?"
         Grownup="Server-side paging. The browser holds one page; the database holds the truth.">
    <p>
        Imagine a filing cabinet in the back room with every order the company has ever taken
        inside it. This page is a little window into that cabinet.
    </p>
    <p>
        It never carries the whole cabinet across the room. It asks for one small handful of
        sheets, shows them to you, and asks again when you want the next handful. That is why the
        page stays fast when the cabinet has a million sheets in it.
    </p>
</Explain>

<div class="filters">
    <div class="field field-grow">
        <label for="q">Search</label>
        @*
            @oninput, not @onchange. @onchange fires when the box loses focus, which means the
            list only updates once you click somewhere else - the difference between a search box
            and a form field. The cost of firing on every keystroke is handled by the debounce in
            OnSearchInput, not by making the user press Enter.
        *@
        <input id="q"
               type="search"
               placeholder="Order number or customer"
               autocomplete="off"
               value="@_request.SearchTerm"
               @oninput="OnSearchInput" />
    </div>

    <div class="field">
        <label for="status">Status</label>
        <select id="status" value="@_statusFilter" @onchange="OnStatusChanged">
            <option value="">All</option>
            @foreach (OrderStatus status in Enum.GetValues<OrderStatus>())
            {
                <option value="@status">@status</option>
            }
        </select>
    </div>

    <div class="field">
        <label for="size">Per page</label>
        <select id="size" value="@_request.PageSize" @onchange="OnPageSizeChanged">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
        </select>
    </div>

    @if (HasActiveFilter)
    {
        <button class="btn btn-quiet" type="button" @onclick="ClearFilters">Clear</button>
    }
</div>

<Explain Emoji="🔎" Title="Why the list changes while you type"
         Grownup="Debounced input, a cancelled in-flight request per keystroke, and a WHERE clause that runs in SQL — never a filter over a list already in memory.">
    <p>
        Type a letter and the page waits a third of a second to see whether you are going to type
        another one. Then it sends the whole word to the server, and the server looks through the
        entire cabinet — like asking the librarian instead of reading every book yourself.
    </p>
    <p>
        If you type again before the answer comes back, the old question is thrown in the bin. That
        is the only reason a slow answer to <em>ord</em> can never land on top of the answer to
        <em>order-7</em>.
    </p>
</Explain>

@if (_error is not null)
{
    <div class="banner banner-error" role="alert">
        <strong>@_error.Message</strong>
        <span class="code">@_error.Code@(_error.Status > 0 ? $" · HTTP {_error.Status}" : "")</span>
        <button class="btn" type="button" @onclick="LoadAsync">Retry</button>
    </div>
}

@if (StatusMix.Count > 0)
{
    @*
        The shape of the page you are looking at, in one line of colour. Not a chart, not a
        dashboard - the widths are set inline from the counts, so when the page changes the
        segments SLIDE to their new size and you see the mix change rather than being handed a
        different picture.
    *@
    <div class="mix">
        <div class="mix-bar" aria-hidden="true">
            @foreach ((OrderStatus status, int count) in StatusMix)
            {
                <span class="mix-seg seg-@status.ToString().ToLowerInvariant()"
                      style="@SegmentStyle(count)"
                      title="@count × @status"></span>
            }
        </div>

        <p class="mix-legend">
            @foreach ((OrderStatus status, int count) in StatusMix)
            {
                <span class="mix-key" title="@OrderStatusText.Kid(status)">
                    <span class="mix-dot seg-@status.ToString().ToLowerInvariant()" aria-hidden="true"></span>
                    @count @status
                </span>
            }
        </p>
    </div>

    <Explain Emoji="🧱" Title="That stripe of colours"
             Grownup="A per-page distribution, computed client-side from the rows already fetched. It is not a metric — a real report would aggregate across every row in SQL.">
        <p>
            It is the handful of sheets in your hand, sorted into colour piles: how many are still
            being written, how many are in a van, how many arrived.
        </p>
        <p>
            It only counts the ones on <em>this</em> page. Turn to page 2 and the stripe changes,
            because it is describing what you are holding — not the whole cabinet.
        </p>
    </Explain>
}

<div class="table-wrap @(_loading && _page is not null ? "is-loading" : null)">
    @*
        The load indicator. It replaces the "Loading…" veil that used to cover the rows: a veil
        hides the data you are waiting to compare against, and it lands in the middle of the table
        where nothing else ever appears. A 2px sweep at the top edge says the same thing without
        taking anything away, and the rows underneath just dim.
    *@
    @if (_loading)
    {
        <div class="load-bar" role="status" aria-label="Loading orders"></div>
    }

    <table>
        <thead>
            <tr>
                <SortHeader Field="OrderSortField.OrderNumber" Label="Order"
                            Current="_request.SortBy" Direction="_request.SortDirection" OnSort="SortBy" />
                <th scope="col">Customer</th>
                <SortHeader Field="OrderSortField.Status" Label="Status"
                            Current="_request.SortBy" Direction="_request.SortDirection" OnSort="SortBy" />
                <th scope="col" class="right">Lines</th>
                <SortHeader Field="OrderSortField.Total" Label="Total" Right="true"
                            Current="_request.SortBy" Direction="_request.SortDirection" OnSort="SortBy" />
                <SortHeader Field="OrderSortField.CreatedAt" Label="Created"
                            Current="_request.SortBy" Direction="_request.SortDirection" OnSort="SortBy" />
            </tr>
        </thead>
        <tbody>
            @if (_loading && _page is null)
            {
                @*
                    Skeleton rows, and ONLY on the very first load. Once there is a page on screen
                    the old rows stay and dim instead: replacing real data with grey bars on every
                    keystroke is flicker, not feedback. The skeleton exists so the first paint has
                    the shape of the answer rather than a hole.
                *@
                @for (int i = 0; i < SkeletonRows; i++)
                {
                    <tr class="sk-row" aria-hidden="true">
                        <td><span class="sk sk-w-60"></span></td>
                        <td><span class="sk sk-w-80"></span></td>
                        <td><span class="sk sk-w-40"></span></td>
                        <td><span class="sk sk-w-40 sk-right"></span></td>
                        <td><span class="sk sk-w-60 sk-right"></span></td>
                        <td><span class="sk sk-w-80"></span></td>
                    </tr>
                }
            }
            else if (_page is { Items.Count: > 0 })
            {
                @foreach (OrderSummary order in _page.Items)
                {
                    @*
                        @key on the order id. Without it Blazor matches rows by position, so paging
                        from page 1 to page 2 patches ten existing <tr> elements in place and
                        nothing is ever "new" - which is both a subtle diffing bug when rows carry
                        state, and the reason the entrance animation would never play. With it,
                        genuinely new rows are new elements and they slide in; re-sorting the same
                        rows moves them without a false "fresh data" flash.
                    *@
                    <tr class="row-link" @key="order.Id" @onclick="() => OpenOrder(order.Id)">
                        <td>
                            @* A real anchor, not just a click handler: middle-click, ctrl-click and
                               "copy link" all have to work, and a div cannot do any of them. *@
                            <a class="cell-link" href="@($"/orders/{order.Id}")" @onclick:stopPropagation="true">
                                @order.OrderNumber
                            </a>
                        </td>
                        <td>@order.CustomerName</td>
                        <td><StatusPill Status="order.Status" /></td>
                        <td class="right num">@order.LineCount</td>
                        <td class="right num">@Money(order.TotalAmount, order.Currency)</td>
                        <td class="num muted">@Date(order.CreatedAtUtc)</td>
                    </tr>
                }
            }
            else if (!_loading && _error is null)
            {
                <tr>
                    <td colspan="6" class="empty">
                        @(HasActiveFilter
                            ? "No orders match these filters."
                            : "No orders yet. Start the API — it seeds sample data on first run.")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_page is not null && _page.TotalCount > 0)
{
    <div class="pager">
        <span class="pager-count">
            @FirstRow–@LastRow of @_page.TotalCount.ToString("N0", CultureInfo.InvariantCulture)
        </span>

        <div class="pager-buttons">
            <button class="btn" type="button" disabled="@(!_page.HasPrevious || _loading)"
                    @onclick="() => GoToPage(_page.Page - 1)">Previous</button>

            <span class="pager-page">Page @_page.Page of @_page.TotalPages</span>

            <button class="btn" type="button" disabled="@(!_page.HasNext || _loading)"
                    @onclick="() => GoToPage(_page.Page + 1)">Next</button>
        </div>
    </div>
}

<Explain Emoji="📚" Title="Clicking a heading, and the Next button"
         Grownup="ORDER BY plus OFFSET/FETCH in the query. Sorting a page you already hold sorts ten rows; sorting in the database sorts a million.">
    <p>
        When you click <strong>Total</strong>, this page does not tidy up the rows it is holding.
        It asks the cabinet for the sheets again, in the new order.
    </p>
    <p>
        That sounds like extra work, and it is the whole point. If it sorted the handful in your
        hand, the biggest order in the company would never appear — because it was on page 40 and
        was never in your hand to begin with.
    </p>
</Explain>

@code {
    /// <summary>How long to wait after the last keystroke before asking the server.</summary>
    /// <remarks>
    /// 300ms is roughly the gap between words when someone is typing rather than thinking. Lower
    /// and every letter becomes a query; much higher and the list feels like it is lagging behind
    /// the keyboard.
    /// </remarks>
    private static readonly TimeSpan SearchDebounce = TimeSpan.FromMilliseconds(300);

    /// <summary>Placeholder rows drawn on the very first load.</summary>
    private const int SkeletonRows = 6;

    private readonly OrderSearchRequest _request = new();

    private PagedResult<OrderSummary>? _page;
    private ApiError? _error;
    private bool _loading;
    private string _statusFilter = string.Empty;

    // One source per in-flight request. Typing quickly fires several searches; without this the
    // slowest response wins and the grid shows results for a query the user has already changed.
    private CancellationTokenSource? _cts;

    // A second, separate source for the keystroke timer. It has to be separate: cancelling the
    // debounce must abandon a PENDING search, while cancelling _cts abandons one already in
    // flight. Sharing one source would make the first keystroke after a slow request cancel the
    // request it was waiting for.
    private CancellationTokenSource? _debounce;

    private bool HasActiveFilter =>
        !string.IsNullOrWhiteSpace(_request.SearchTerm) || _request.Status is not null;

    private int FirstRow => _page is null || _page.TotalCount == 0
        ? 0
        : ((_page.Page - 1) * _page.PageSize) + 1;

    private int LastRow => _page is null
        ? 0
        : Math.Min(_page.Page * _page.PageSize, _page.TotalCount);

    /// <summary>Status counts for the rows currently on screen, in lifecycle order.</summary>
    private IReadOnlyList<(OrderStatus Status, int Count)> StatusMix =>
        _page is null
            ? []
            : [.. _page.Items
                .GroupBy(order => order.Status)
                .OrderBy(group => group.Key)
                .Select(group => (group.Key, group.Count()))];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        // Cancel whatever is in flight before starting the next one.
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
        }

        _cts = new CancellationTokenSource();
        CancellationToken token = _cts.Token;

        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            ApiResult<PagedResult<OrderSummary>> result = await Api.SearchOrdersAsync(_request, token);

            if (token.IsCancellationRequested)
            {
                return;
            }

            if (result.IsSuccess)
            {
                _page = result.Value;
            }
            else
            {
                _error = result.Error;
            }
        }
        catch (OperationCanceledException)
        {
            // A superseded search. Not an error, and deliberately not surfaced.
            return;
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _loading = false;
            }
        }
    }

    /// <summary>
    /// Records the keystroke, then searches only once the typing stops.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The delay is awaited rather than run on a <c>System.Timers.Timer</c>, and that removes a
    /// whole class of bug: a timer callback arrives on a thread pool thread, where touching
    /// component state or calling <c>StateHasChanged</c> without <c>InvokeAsync</c> is a race. The
    /// continuation of this <c>await</c> resumes on Blazor's renderer synchronisation context,
    /// because that is where the event handler started.
    /// </para>
    /// <para>
    /// Each keystroke cancels the previous pending delay, so N keystrokes produce one search, not
    /// N searches that race each other.
    /// </para>
    /// </remarks>
    /// <param name="e">The input event carrying the box's current text.</param>
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _request.SearchTerm = e.Value?.ToString();

        if (_debounce is not null)
        {
            await _debounce.CancelAsync();
            _debounce.Dispose();
        }

        _debounce = new CancellationTokenSource();

        try
        {
            await Task.Delay(SearchDebounce, _debounce.Token);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a later keystroke; that one owns the search now.
            return;
        }

        await ResetAndLoadAsync();
    }

    private Task OnStatusChanged(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? string.Empty;

        _request.Status = Enum.TryParse(_statusFilter, out OrderStatus parsed)
            ? parsed
            : null;

        return ResetAndLoadAsync();
    }

    private Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out int size))
        {
            _request.PageSize = size;
        }

        return ResetAndLoadAsync();
    }

    private Task ClearFilters()
    {
        _request.SearchTerm = null;
        _request.Status = null;
        _statusFilter = string.Empty;
        return ResetAndLoadAsync();
    }

    /// <summary>Any filter change must return to page 1 — page 7 of a new result set is nonsense.</summary>
    private Task ResetAndLoadAsync()
    {
        _request.Page = 1;
        return LoadAsync();
    }

    private Task GoToPage(int page)
    {
        _request.Page = page;
        return LoadAsync();
    }

    private Task SortBy(OrderSortField field)
    {
        // Same column toggles direction; a new column starts descending, which is the useful
        // default for dates and money.
        if (_request.SortBy == field)
        {
            _request.SortDirection = _request.SortDirection == SortDirection.Ascending
                ? SortDirection.Descending
                : SortDirection.Ascending;
        }
        else
        {
            _request.SortBy = field;
            _request.SortDirection = SortDirection.Descending;
        }

        return ResetAndLoadAsync();
    }

    private void OpenOrder(Guid id) => Nav.NavigateTo($"/orders/{id}");

    /// <summary>Width of one segment of the mix bar, as a percentage of the visible rows.</summary>
    /// <param name="count">Rows in this status.</param>
    /// <returns>An inline <c>width</c> declaration.</returns>
    /// <remarks>
    /// InvariantCulture is not optional here. On a machine with an Italian locale the default
    /// formatting produces <c>width:33,33%</c>, which is not a CSS length — the browser drops the
    /// declaration and every segment collapses. The same reason every other number in this
    /// codebase carries a culture.
    /// </remarks>
    private string SegmentStyle(int count)
    {
        int total = _page?.Items.Count ?? 0;
        double percent = total == 0 ? 0 : count * 100.0 / total;

        return string.Create(CultureInfo.InvariantCulture, $"width:{percent:0.##}%");
    }

    private static string Money(decimal amount, string currency) =>
        string.Create(CultureInfo.InvariantCulture, $"{amount:N2} {currency}");

    private static string Date(DateTimeOffset value) =>
        value.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();

        _debounce?.Cancel();
        _debounce?.Dispose();
    }
}
