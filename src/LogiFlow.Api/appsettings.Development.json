{
  // Local development settings. Everything here points at software running NATIVELY on your
  // machine - a locally installed SQL Server, no Redis, no collector. Nothing in this file
  // requires Docker.
  //
  // If you would rather run the containerised stack (SQL Server + Redis + Aspire Dashboard),
  // use the `docker` launch profile: `dotnet run --launch-profile docker`. It overrides the
  // three keys below via environment variables and changes nothing else.
  // See course/module-00-setup/02-running-the-stack.md.
  //
  // Any secret in this file is a DEVELOPMENT-ONLY throwaway and is safe to commit because it
  // only ever unlocks something on your own machine. Production values come from environment
  // variables or a key vault - never from a file in the repository.
  // See course/module-13-deployment/02-configuration.md.

  "ConnectionStrings": {
    // Integrated Security means Windows Authentication: no username and no password, because
    // your Windows account IS the credential. That is not a convenience - it is the reason
    // there is no password to leak from this file. It is also how most Italian shops connect
    // to an on-premise SQL Server, so it is worth being fluent in.
    //
    // TrustServerCertificate is required because a default SQL Server installation encrypts
    // with a self-signed certificate. Setting it in production would disable the protection
    // TLS exists to provide - there you install a real certificate instead.
    //
    // `Server=localhost` is the default instance. For a named instance use
    // `Server=localhost\SQLEXPRESS`, and note the escaped backslash: JSON, not SQL, owns
    // that string. For LocalDB use `Server=(localdb)\MSSQLLocalDB`.
    "SqlServer": "Server=localhost;Database=LogiFlow;Integrated Security=True;TrustServerCertificate=True;Encrypt=True",

    // Empty on purpose. LogiFlow.Infrastructure reads this key and, when it is blank, registers
    // AddDistributedMemoryCache instead of Redis - see the comment at DependencyInjection.cs.
    // The cache-aside code in module 10 runs unchanged either way, which is the entire point of
    // coding against IDistributedCache rather than against Redis.
    //
    // What you LOSE by leaving it blank is the part that matters: an in-memory cache is not
    // distributed. Two instances of the API each get their own copy and they will disagree.
    // To see that failure - and the fix - fill this in and run the `docker` profile.
    "Redis": ""
  },

  "Jwt": {
    "Issuer": "logiflow",
    "Audience": "logiflow-api",
    // Must be at least 32 bytes for HMAC-SHA256; startup validation enforces it.
    "SigningKey": "dev-only-signing-key-do-not-use-in-production-0123456789",
    "ExpiryMinutes": 480
  },

  // Empty means "no collector is running". Program.cs treats this as a CAPABILITY check: with
  // no endpoint it registers the instrumentation but skips every OTLP exporter, so traces and
  // metrics are still produced in-process and simply not shipped anywhere. Serilog keeps
  // writing to the console regardless.
  //
  // Set it to http://localhost:18889 when you have an OTLP collector listening - the `docker`
  // profile does exactly that for the Aspire Dashboard.
  "Otlp": {
    "Endpoint": ""
  },

  // ── Mail ─────────────────────────────────────────────────────────────────────────────────
  // "File" writes each message to App_Data/mail as a .eml file, which opens in Outlook or
  // Thunderbird exactly as the customer would see it - HTML rendering, encoded headers and all.
  // It needs nothing installed and cannot possibly reach a real person.
  //
  // The alternatives:
  //   "Log"  - the message goes to the console. Zero setup, no HTML.
  //   "Smtp" - a real send. With the `docker` launch profile this points at Mailpit
  //            (http://localhost:8025), which captures everything and shows it in a browser.
  //            Pointing it at a real relay from a development machine is how the incident that
  //            RedirectAllTo exists to prevent usually starts.
  //
  // RedirectAllTo is left empty here because the File transport already cannot deliver. In a
  // STAGING environment it should always be set: see the remarks on RedirectingEmailSender.
  // Covered in: course/module-10-cross-cutting/05-mailing.md
  "Mailing": {
    "Transport": "File",
    "PickupDirectory": "App_Data/mail",
    "Delivery": {
      // Faster than the production default, so a queued message appears while you are still
      // looking at the terminal that caused it.
      "PollSeconds": 2
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",

        // Set this to Information to see every SQL statement EF Core executes, with parameters.
        // The single most useful debugging switch in the whole file - and the reason the course
        // can show you the SQL behind each LINQ query. Left at Warning by default because it is
        // extremely chatty.
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
