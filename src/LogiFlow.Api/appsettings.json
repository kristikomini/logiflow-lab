{
  "ConnectionStrings": {
    "SqlServer": "",
    "Redis": ""
  },

  // Kestrel has to speak HTTP/2 for gRPC, and over PLAIN HTTP it will not negotiate its way
  // there — without TLS there is no ALPN, so the client and server never agree to upgrade and
  // every gRPC call fails with a protocol error that mentions neither HTTP/2 nor this setting.
  // Http1AndHttp2 lets one endpoint serve the REST API over HTTP/1.1 and gRPC over h2c.
  //
  // In production behind TLS this is unnecessary: ALPN picks HTTP/2 on its own. It is left here
  // because "works over https, fails over http" is a genuinely confusing afternoon.
  //
  // Covered in: course/module-25-distributed-systems/07-grpc.md
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },

  "Jwt": {
    "Issuer": "logiflow",
    "Audience": "logiflow-api",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "Otlp": {
    "Endpoint": "http://localhost:18889"
  },
  "Mailing": {
    "Transport": "Log",
    "FromAddress": "no-reply@logiflow.example",
    "FromName": "LogiFlow",
    "ReplyToAddress": "",
    "PickupDirectory": "App_Data/mail",
    "RedirectAllTo": "",
    "AllowedRecipientDomains": [],
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "UseTls": false,
      "UserName": "",
      "Password": ""
    },
    "Delivery": {
      "PollSeconds": 5,
      "BatchSize": 20,
      "MaxAttempts": 5,
      "RetryBaseSeconds": 30,
      "LeaseSeconds": 120,
      "RetentionDays": 30
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
